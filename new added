import java.security.*;
public class DSSExample {
public static void main(String[] args) throws Exception {
String message = "hello";
// 1. Generate DSA Key Pair - DSS requires DSA keys (not RSA)
KeyPairGenerator keyGen = KeyPairGenerator.getInstance("DSA");
keyGen.initialize(2048); // DSS standard key size
KeyPair keyPair = keyGen.generateKeyPair();
// 2. Sign with Private Key
// DSS uses SHA256withDSA (modern version of SHA1withDSA)
Signature dsaSign = Signature.getInstance("SHA256withDSA");
dsaSign.initSign(keyPair.getPrivate());
dsaSign.update(message.getBytes());
byte[] signature = dsaSign.sign();
System.out.println("Message: " + message);
System.out.println("DSS Signature generated");
// 3. Verify with Public Key
dsaSign.initVerify(keyPair.getPublic());
dsaSign.update(message.getBytes());
boolean verified = dsaSign.verify(signature);
System.out.println("Verified: " + verified);
// 4. Tamper test
dsaSign.initVerify(keyPair.getPublic());
dsaSign.update("tampered message".getBytes());
System.out.println("Tampered Verified: " + dsaSign.verify(signature));
}
