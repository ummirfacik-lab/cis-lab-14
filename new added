USING RAIL FENCE TRANSPOSITION TECHNIQUE
import java.util.*;
class RailFenceCipher {
    static String encrypt(String t, int r){
        StringBuilder[] a = new StringBuilder[r];
        for(int i=0;i<r;i++) a[i]=new StringBuilder();
        int row=0,d=1;
        for(char c:t.toCharArray()){
            a[row].append(c);
            if(row==0) d=1; else if(row==r-1) d=-1;
            row+=d;
        }
        StringBuilder s=new StringBuilder();
        for(var x:a) s.append(x);
        return s.toString();
    }
    static String decrypt(String c, int r){
        int n=c.length(); char[][] f=new char[r][n];
        int row=0,d=1;
        for(int i=0;i<n;i++)
        { f[row][i]='*';   if(row==0) d=1;   else if(row==r-1)   d=-1;   row+=d; }
        int k=0;
        for(int i=0;i<r;i++) for(int j=0;j<n;j++)  if(f[i][j]=='*') f[i][j]=c.charAt(k++);
        StringBuilder s=new StringBuilder();  row=0; d=1;
        for(int i=0;i<n;i++)
       { s.append(f[row][i]); if(row==0) d=1; else if(row==r-1) d=-1; row+=d; }
        return s.toString();
    }
    public static void main(String[] a){
        Scanner sc=new Scanner(System.in);
        System.out.print("Text: "); String t=sc.nextLine();
        System.out.print("Rails: "); int r=sc.nextInt();
        String e=encrypt(t,r);
        System.out.println("Encrypted: "+e);
        System.out.println("Decrypted: "+decrypt(e,r));
    }
}



LAB 5: WRITE A JAVA PROGRAM TO IMPLEMENT SINGLE AND DOUBLE 
TRANSPOSITION TECHNIQUE
import java.util.*;
public class ColumnarTranspositionCipher {
    static int[] getKey(String keykey) {
        String k = keykey.toUpperCase();
        int n = k.length();
        int[] key = new int[n];
        Integer[] idx = new Integer[n];
        for (int i = 0; i < n; i++) idx[i] = i;
        Arrays.sort(idx, (a, b) -> k.charAt(a)!= k.charAt(b)? k.charAt(a) - k.charAt(b) : a - b);
        for (int r = 0; r < n; r++) key[idx[r]] = r + 1;
        return key;
    }
    static String encrypt(String pt, int[] key) {
        int c = key.length, r = (int) Math.ceil((double) pt.length() / c);
        char[][] g = new char[r][c];
        for (int i = 0; i < r * c; i++) g[i / c][i % c] = i < pt.length()? pt.charAt(i) : '_';
        StringBuilder sb = new StringBuilder();
        for (int k = 1; k <= c; k++)
            for (int j = 0; j < c; j++) if (key[j] == k)
                for (int i = 0; i < r; i++) sb.append(g[i][j]);
        return sb.toString();
    }
    static String decrypt(String ct, int[] key) {
        int c = key.length, r = ct.length() / c;
        char[][] g = new char[r][c];
        int p = 0;
        for (int k = 1; k <= c; k++)
            for (int j = 0; j < c; j++) if (key[j] == k)
                for (int i = 0; i < r; i++) g[i][j] = ct.charAt(p++);
        StringBuilder sb = new StringBuilder();
        for (char[] row : g) for (char ch : row) sb.append(ch);
        return sb.toString();
    }
    // Double Transposition
    static String doubleEncrypt(String pt, int[] key) {
        return encrypt(encrypt(pt, key), key);
    }
    static String doubleDecrypt(String ct, int[] key) {
        return decrypt(decrypt(ct, key), key);
    }
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Plaintext: ");
        String msg = sc.nextLine().replace(" ", "");
        System.out.print("Key: ");
        String skey = sc.next();
        int[] key = getKey(skey);
        System.out.println("\nNumeric Key: " + Arrays.toString(key));
        String singleEnc = encrypt(msg, key);
        System.out.println("\n--- Single Transposition ---");
        System.out.println("Encrypted: " + singleEnc);
        System.out.println("Decrypted: " + decrypt(singleEnc, key));
        String doubleEnc = doubleEncrypt(msg, key);
        System.out.println("\n--- Double Transposition ---");
        System.out.println("Encrypted: " + doubleEnc);
        System.out.println("Decrypted: " + doubleDecrypt(doubleEnc, 
key).replace("_",""));
    }
}



LAB 6: WRITE A JAVA PROGRAM TO IMPLEMENT DES ALGORITHM LOGIC
import javax.crypto.Cipher;
import javax.crypto.SecretKey;
import javax.crypto.SecretKeyFactory;
import javax.crypto.spec.DESKeySpec;
import java.util.Base64;
import java.util.Scanner;
public class DESWithUserKey {
    public static void main(String[] args) throws Exception {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter Plaintext: ");
        String plainText = sc.nextLine();
        System.out.print("Enter Key (must be 8 chars e.g. 12345678): ");
        String keyInput = sc.nextLine();
        // 1. Make key from user input string
        DESKeySpec desKeySpec = new DESKeySpec(keyInput.getBytes());
        SecretKeyFactory keyFactory = SecretKeyFactory.getInstance("DES");
        SecretKey secretKey = keyFactory.generateSecret(desKeySpec);
        // 2. Encrypt
        Cipher cipher = Cipher.getInstance("DES/ECB/PKCS5Padding");
        cipher.init(Cipher.ENCRYPT_MODE, secretKey);
        byte[] encryptedBytes = cipher.doFinal(plainText.getBytes());
        String encryptedText = 
Base64.getEncoder().encodeToString(encryptedBytes);
        System.out.println("Encrypted: " + encryptedText);
        // 3. Decrypt
        cipher.init(Cipher.DECRYPT_MODE, secretKey);
        byte[] decryptedBytes = 
cipher.doFinal(Base64.getDecoder().decode(encryptedText));
        String decryptedText = new String(decryptedBytes);
        System.out.println("Decrypted: " + decryptedText);
    }
}
